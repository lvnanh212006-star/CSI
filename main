import json

html_start = """<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tổng hợp 80 Câu Hỏi Ôn Tập - CSI 05, 06, 07, 08</title>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; max-width: 900px; margin: 0 auto; padding: 20px; background-color: #f4f7f6; color: #333; }
        h1 { text-align: center; color: #2c3e50; font-size: 2.2em; margin-bottom: 10px;}
        h2.section-title { background: #34495e; color: white; padding: 10px 15px; border-radius: 5px; margin-top: 40px; margin-bottom: 20px;}
        .question-block { background: #fff; padding: 20px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); margin-bottom: 20px; border-left: 5px solid #3498db; }
        .question-title { font-weight: bold; margin-bottom: 12px; font-size: 1.1em; color: #2c3e50;}
        .options label { display: block; margin-bottom: 8px; cursor: pointer; padding: 8px; border-radius: 4px; transition: background 0.2s; }
        .options label:hover { background-color: #f1f2f6; }
        .btn-group { display: flex; justify-content: center; gap: 15px; margin-top: 40px; margin-bottom: 50px; position: sticky; bottom: 20px; z-index: 100;}
        button { padding: 15px 35px; font-size: 18px; border: none; border-radius: 8px; cursor: pointer; font-weight: bold; transition: 0.2s; box-shadow: 0 4px 6px rgba(0,0,0,0.2); }
        .btn-submit { background-color: #27ae60; color: white; }
        .btn-submit:hover { background-color: #2ecc71; transform: translateY(-2px); }
        .btn-redo { background-color: #e74c3c; color: white; }
        .btn-redo:hover { background-color: #ff6b81; transform: translateY(-2px); }
        #score-container { text-align: center; margin-top: 25px; font-size: 1.8em; font-weight: bold; color: #2c3e50; display: none; padding: 20px; background: #fff; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); border: 2px solid #27ae60;}
        .explanation { margin-top: 15px; padding: 12px; background-color: #e8f4f8; border-left: 4px solid #3498db; font-style: italic; display: none; font-size: 0.95em; color: #2c3e50; line-height: 1.5;}
    </style>
</head>
<body>
    <h1>Tổng hợp 80 Câu Hỏi Ôn Tập - CSI</h1>
    <p style="text-align: center; color: #7f8c8d; margin-bottom: 30px; font-size: 1.1em;">
        Bao gồm 4 học phần: <strong>CSI_05, CSI_06, CSI_07, CSI_08</strong> (Mỗi phần 20 câu)<br>
        Chọn đáp án, cuộn xuống dưới cùng nhấn <strong>"Nộp bài"</strong> để xem điểm & giải thích.<br>
        Nhấn <strong>"Làm lại"</strong> để xoá lựa chọn và bắt đầu lại!
    </p>
    <div id="score-container">
        Thành tích của bạn: <span id="score" style="color: #27ae60;">0</span> / 80
    </div>
    <form id="quizForm">
"""

html_questions = ""
answers_dict = {}
current_cat = ""

for i, data in enumerate(q_data, 1):
    cat, q_text, optA, optB, optC, optD, ans, expl = data
    q_id = f"q{i}"
    answers_dict[q_id] = ans
    
    if cat != current_cat:
        html_questions += f'<h2 class="section-title">{cat}</h2>'
        current_cat = cat
        
    html_questions += f"""
        <div class="question-block">
            <div class="question-title">Câu {i}. {q_text}</div>
            <div class="options">
                <label><input type="radio" name="{q_id}" value="A"> A. {optA}</label>
                <label><input type="radio" name="{q_id}" value="B"> B. {optB}</label>
                <label><input type="radio" name="{q_id}" value="C"> C. {optC}</label>
                <label><input type="radio" name="{q_id}" value="D"> D. {optD}</label>
            </div>
            <div class="explanation" id="expl-{q_id}">
                <strong>Giải thích:</strong> Đáp án đúng là {ans}. <br>Trích nguồn: "{expl}"
            </div>
        </div>"""

html_end = f"""
        <div class="btn-group">
            <button type="button" class="btn-submit" onclick="submitQuiz()">Nộp bài</button>
            <button type="button" class="btn-redo" onclick="resetQuiz()">Làm lại</button>
        </div>
    </form>

    <script>
        const answers = {json.dumps(answers_dict)};

        function submitQuiz() {{
            let score = 0;
            let form = document.getElementById('quizForm');
            
            for (let key in answers) {{
                let options = form.elements[key];
                let explanation = document.getElementById('expl-' + key);
                explanation.style.display = 'block';
                
                if (options) {{
                    let answered = false;
                    for (let i = 0; i < options.length; i++) {{
                        if (options[i].checked) {{
                            answered = true;
                            if (options[i].value === answers[key]) {{
                                score++;
                                options[i].parentElement.style.color = '#27ae60';
                                options[i].parentElement.style.fontWeight = 'bold';
                            }} else {{
                                options[i].parentElement.style.color = '#e74c3c';
                                options[i].parentElement.style.textDecoration = 'line-through';
                            }}
                        }} else if (options[i].value === answers[key]) {{
                            options[i].parentElement.style.color = '#2980b9';
                            options[i].parentElement.style.fontWeight = 'bold';
                        }}
                        options[i].disabled = true;
                    }}
                }}
            }}
            
            document.getElementById('score').innerText = score;
            document.getElementById('score-container').style.display = 'block';
            window.scrollTo({{ top: 0, behavior: 'smooth' }});
        }}

        function resetQuiz() {{
            let form = document.getElementById('quizForm');
            form.reset(); 
            
            document.getElementById('score-container').style.display = 'none';
            
            for (let key in answers) {{
                let options = form.elements[key];
                let explanation = document.getElementById('expl-' + key);
                explanation.style.display = 'none';
                
                if (options) {{
                    for (let i = 0; i < options.length; i++) {{
                        options[i].disabled = false;
                        options[i].parentElement.style.color = '#333';
                        options[i].parentElement.style.fontWeight = 'normal';
                        options[i].parentElement.style.textDecoration = 'none';
                    }}
                }}
            }}
            window.scrollTo({{ top: 0, behavior: 'smooth' }});
        }}
    </script>
</body>
</html>
"""

with open("Interactive_Quiz_CSI_All_80.html", "w", encoding="utf-8") as f:
    f.write(html_start + html_questions + html_end)

print("80-question file generated successfully.")

