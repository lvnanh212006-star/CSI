        <div class="btn-group">
            <button type="button" class="btn-submit" onclick="submitQuiz()">Nộp bài</button>
            <button type="button" class="btn-redo" onclick="resetQuiz()">Làm lại</button>
        </div>
    </form>

    <script>
        const answers = {"q1": "C", "q2": "B", "q3": "B", "q4": "C", "q5": "B", "q6": "C", "q7": "C", "q8": "B", "q9": "B", "q10": "C", "q11": "A", "q12": "B", "q13": "A", "q14": "C", "q15": "C", "q16": "B", "q17": "C", "q18": "C", "q19": "B", "q20": "C", "q21": "B", "q22": "A", "q23": "B", "q24": "B", "q25": "B", "q26": "C", "q27": "B", "q28": "C", "q29": "C", "q30": "A", "q31": "B", "q32": "C", "q33": "B", "q34": "C", "q35": "A", "q36": "B", "q37": "A", "q38": "C", "q39": "A", "q40": "B", "q41": "B", "q42": "C", "q43": "B", "q44": "A", "q45": "B", "q46": "B", "q47": "A", "q48": "B", "q49": "C", "q50": "B", "q51": "B", "q52": "B", "q53": "A", "q54": "B", "q55": "B", "q56": "B", "q57": "B", "q58": "C", "q59": "A", "q60": "B", "q61": "B", "q62": "C", "q63": "C", "q64": "A", "q65": "B", "q66": "B", "q67": "C", "q68": "B", "q69": "A", "q70": "B", "q71": "A", "q72": "C", "q73": "B", "q74": "B", "q75": "B", "q76": "B", "q77": "B", "q78": "B", "q79": "B", "q80": "A"};

        function submitQuiz() {
            let score = 0;
            let form = document.getElementById('quizForm');
            
            for (let key in answers) {
                let options = form.elements[key];
                let explanation = document.getElementById('expl-' + key);
                explanation.style.display = 'block';
                
                if (options) {
                    let answered = false;
                    for (let i = 0; i < options.length; i++) {
                        if (options[i].checked) {
                            answered = true;
                            if (options[i].value === answers[key]) {
                                score++;
                                options[i].parentElement.style.color = '#27ae60';
                                options[i].parentElement.style.fontWeight = 'bold';
                            } else {
                                options[i].parentElement.style.color = '#e74c3c';
                                options[i].parentElement.style.textDecoration = 'line-through';
                            }
                        } else if (options[i].value === answers[key]) {
                            options[i].parentElement.style.color = '#2980b9';
                            options[i].parentElement.style.fontWeight = 'bold';
                        }
                        options[i].disabled = true;
                    }
                }
            }
            
            document.getElementById('score').innerText = score;
            document.getElementById('score-container').style.display = 'block';
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function resetQuiz() {
            let form = document.getElementById('quizForm');
            form.reset(); 
            
            document.getElementById('score-container').style.display = 'none';
            
            for (let key in answers) {
                let options = form.elements[key];
                let explanation = document.getElementById('expl-' + key);
                explanation.style.display = 'none';
                
                if (options) {
                    for (let i = 0; i < options.length; i++) {
                        options[i].disabled = false;
                        options[i].parentElement.style.color = '#333';
                        options[i].parentElement.style.fontWeight = 'normal';
                        options[i].parentElement.style.textDecoration = 'none';
                    }
                }
            }
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }
    </script>
</body>
